# Public site URL (SEO / Open Graph + Stripe success/cancel URLs)
NEXT_PUBLIC_SITE_URL=https://kilometrowka-nine.vercel.app

# --- Stripe Checkout Sessions (primary) ---
# Server-only secret — never expose to the client / NEXT_PUBLIC_*
STRIPE_SECRET_KEY=sk_test_...
# Recurring Price IDs from Stripe Dashboard → Products (test)
STRIPE_PRICE_ID_MONTHLY=price_1UI50U3tQI0I8OZKD5G1hZwK
STRIPE_PRICE_ID_YEARLY=price_1UI50U3tQI0I8OZKEOxbDiIc
# Premium product (prices above belong to it). Webhook/activate grant Premium only for this product.
STRIPE_PRODUCT_ID_PREMIUM=prod_...
# Signing secret of the webhook endpoint → https://<site>/api/stripe/webhook
# Events: checkout.session.completed, customer.subscription.created|updated|deleted
STRIPE_WEBHOOK_SECRET=whsec_...

# Optional: Billing Customer Portal configuration (bpc_...). If unset, the app
# uses the account default or creates one (cancel at period end, card update,
# invoice history) on first use.
# STRIPE_PORTAL_CONFIGURATION_ID=

# --- Clerk ---
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/kalkulator
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/kalkulator
# Clerk Dashboard → Webhooks → endpoint https://<site>/api/clerk/webhook
# (events: user.updated, user.deleted). Without it the endpoint answers 503.
CLERK_WEBHOOK_SIGNING_SECRET=whsec_...

# --- Neon ---
DATABASE_URL=postgresql://...
